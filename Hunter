                while_true = confirm("Would you like to edit another product? (y/n): ")
                if not while_true:
                    break
                else:
                    continue 
                    
            if while_true:
                continue
            else:
                break

def delete_products(product_list):
    while True:
        
        miss_input = confirm("Do you wish to continue to delete an product? (y/n): ")
        if miss_input:
            while True:
                while_true = True
                if len(product_list) == 0:
                    print("This is nothing to delete.")
                    while_true = False
                    break
                else:
                    get_product_names(product_list)
                    # To delete an item with confirmation
                    while True:
                        
                        delete_index = get_product_index("Which product number do you want to delete?: ", product_list)
                        
                        delete_index_name = product_list[delete_index-1]["product name"]
                        confirmation = confirm("Are you sure you want to delete  (y/n)")
                        if confirmation:
                            print(f"{delete_index}. {delete_index_name} has been deleted.")
                            product_list.pop(delete_index-1)
                            break
                        else:
                            break
                        
                    delete_again = confirm("Would you like to delete another product? (y/n): ")
                    if delete_again:
                        continue
                    else:
                        while_true = False
                        break
        
            if while_true:
                continue
            else:
                break
        else:
            print("Miss Input")
            break
        

# Show the current list of all the products
def list_products(product_list):
    if len(product_list) == 0:
        print("There is nothing to list")
    else:
        for i in range(len(product_list)):
            product_name = product_list[i]["product name"]
            product_location = product_list[i]["product location"]
            target_price = product_list[i]["target price"]
            current_price = product_list[i]["current price"]
            print(f"This is product {i+1}:")
            print(f"Product Name: {product_name}")
            print(f"Product Location: {product_location}")
            print(f"Target Price: ${target_price:.2f}")
            print(f"Current Price: ${current_price:.2f}\n")


