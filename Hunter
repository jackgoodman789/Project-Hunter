import json
from pathlib import Path


project_folder = Path(__file__).parent
json_file = project_folder / "products.json"

def load_products(json_file):
    
    try:
        with open(json_file, "r") as file:
            product_list = json.load(file)
        print("List has successfully loaded")
    except FileNotFoundError:
        print("Error: File not found")
        product_list = []
    except json.JSONDecodeError:
        print("Error: The file contains invalid JSON formatting.")
        product_list = []
        # except Exception as e:
        #     print(f"An unexpect error occured: {e}")
    return product_list

# Pulling info from .JSON file to be read for program
def save_products(product_list, json_file):
    with open(json_file, "w") as file:
        json.dump(product_list, file, indent=4)

print("Hunter Price Tracker")

# Function to input product information
def product_info():
    product_name = input("What is the product's name?: ")
    product_location = input("Paste the URL here: ")
    target_price = round(float(input("What price do you want it at?: ")), 2)
    current_price = round(float(input("What is it currently at?: ")), 2)

    product_data = {
    "product name": product_name,
    "product location": product_location,
    "target price": target_price,
    "current price": current_price
}
    return  product_data

def add_products(product_list):
    while True:
        product_data = product_info()
        product_list.append(product_data)
        while_true = True
        while True:
            another_product = input(f"Do you want to add another product(y/n)?: ")
            if another_product == 'y':
                print("Please add a product.")
                break
            elif another_product == 'n':
                print("Finished.")
                while_true = False
                break
            else:
                print("Invalid input.")
                continue
        if while_true:
            continue
        else:
            break

def edit_products(product_list):
    if len(product_list) == 0:
        print("There is nothing to edit")
    else:
        while True:
            for i in range(len(product_list)):
                product_name = product_list[i]["product name"]
                print(f"{i+1}. {product_name}")
            while_true = True
            # To choose which product you want to edit with testing to make sure its a number
            while True:
                edit_index = input(f"Which product number do you want to edit?: ")
                try:
                    edit_index = int(edit_index)
                    break
                except ValueError:
                    print("Invalid input. Please use numbers.")

            if edit_index > len(product_list):
                print("Invalid number")
                continue
            elif edit_index < 1:
                print("Invalid number")
                continue
            else:
                # Edit products and ask if you want to edit more
                while True:
                    # to select and edit different info about products
                    while True:
                        print(f"Name: {product_list[edit_index-1]['product name']}")
                        print(f"URL: {product_list[edit_index-1]['product location']}")
                        print(f"Target Price: {product_list[edit_index-1]['target price']}")
                        print(f"Current Price: {product_list[edit_index-1]['current price']}")
                        edit_info = input(f"What info do you want to edit? ")

                        if edit_info == 'name':
                            new_value = input(f"What do you want for the new name to be? ")
                            product_list[edit_index-1]["product name"] = new_value
                            print(f"The new name is {product_list[edit_index-1]['product name']}")
                            break

                        elif edit_info == 'url':
                            new_value = input(f"What do you want for the new URL to be? ")
                            product_list[edit_index-1]["product location"] = new_value
                            print(f"The new URL is {product_list[edit_index-1]['product location']}")
                            break

                        elif edit_info == 'target price':
                            new_value = round(float(input(f"What do you want for the new target price to be? ")), 2)
                            product_list[edit_index-1]["target price"] = new_value
                            print(f"The new target price is {product_list[edit_index-1]['target price']}")
                            break

                        elif edit_info == 'current price':
                            new_value = round(float(input(f"What do you want for the new current price to be? ")), 2)
                            product_list[edit_index-1]["current price"] = new_value
                            print(f"The new current price is {product_list[edit_index-1]['current price']}")
                            break

                        elif edit_info == 'none':
                            break

                        else:
                            print("Miss input")
                            continue
                
                    edit_again = input(f"Would you like to edit another product? (y/n): ")
                    if edit_again == 'y':
                        continue
                    elif edit_again == 'n':
                        while_true = False
                        break
                    else:
                        print("Invalid answer")
                        continue
            if while_true:
                continue
            else:
                break

def delete_products(product_list):
    while True:
        miss_input = input(f"Do you wish to continue to delete an product? (y/n): ")
        if miss_input == 'y':
            while True:
                for i in range(len(product_list)):
                    potential_d = product_list[i]["product name"]
                    print(f" {i+1}. {potential_d}")
                while_true = True
                if len(product_list) == 0:
                    print("This is nothing to delete.")
                    while_true = False
                    break
                else:

                    # To delete an item with confirmation
                    while True:
                        #making sure delete index is an int
                        while True:
                            delete_index = input(f"Which product number do you want to delete?: ")
                            try:
                                delete_index = int(delete_index)
                                break
                            except ValueError:
                                print("Invalid input. Please use numbers.")
                        
                        if delete_index > len(product_list):
                            print("Invalid entry")
                            continue
                        elif delete_index < 1:
                            print("Invalid entry")
                            continue
                        else:
                            delete_index_name = product_list[delete_index-1]["product name"]
                            confirmation = input(f"Are you sure you want to delete  (y/n)")
                            if confirmation == 'y':
                                print(f"{delete_index}. {delete_index_name} has been deleted.")
                                product_list.pop(delete_index-1)
                                break
                            elif confirmation == 'n':
                                break
                            else:
                                print("Invalid answer")
                        
                    delete_again = input(f"Would you like to delete another product? (y/n): ")
                    if delete_again == 'y':
                        continue
                    elif delete_again == 'n':
                        while_true = False
                        break
                    else:
                        print("Invalid answer")
                        continue
            if while_true:
                continue
            else:
                break
        elif miss_input == 'n':
            break
        else:
            print("Miss input")
            continue

